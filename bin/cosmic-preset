#!/usr/bin/env bash
# cosmic-preset — save, apply and revert COSMIC desktop look presets.
#
# Only the "managed" paths below are ever touched. Everything else in
# ~/.config/cosmic (favorites, keyboard layout, fonts, wallpaper, shortcuts…)
# is left alone, so switching presets never rolls back unrelated settings.
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
LIVE="$CONFIG_HOME/cosmic"
STORE="$CONFIG_HOME/cosmic-presets"
CURRENT="$STORE/.current"
PREVIOUS="$STORE/.previous"       # managed state right before the last apply
FULL_BACKUP="$STORE/.full-backup" # complete copy of ~/.config/cosmic
BASELINE="original"
ALTERNATE="macos-glass"
LIGHT="macos-light"

# Whole directories, mirrored exactly (extra files are removed).
MANAGED_DIRS=(
  com.system76.CosmicPanel.Dock/v1
  com.system76.CosmicPanel.Panel/v1
  # Theme: accent colour, corner radii, frosted glass (dark and light).
  com.system76.CosmicTheme.Dark/v2
  com.system76.CosmicTheme.Dark.Builder/v2
  com.system76.CosmicTheme.Light/v2
  com.system76.CosmicTheme.Light.Builder/v2
)
# Individual keys. A key missing from the source is removed from the target
# (COSMIC then falls back to its default).
MANAGED_FILES=(
  com.system76.CosmicPanel/v1/entries
  com.system76.CosmicFiles/v1/show_details
  com.system76.CosmicFiles/v1/tab
  com.system76.CosmicFiles/v1/dialog
  com.system76.CosmicFiles/v1/desktop
  com.system76.CosmicComp/v1/appearance_settings
  com.system76.CosmicTk/v1/icon_theme
  com.system76.CosmicTk/v1/header_size
  com.system76.CosmicTk/v1/interface_density
  com.system76.CosmicTheme.Mode/v1/is_dark
)

die() { echo "cosmic-preset: $*" >&2; exit 1; }

notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -a "COSMIC Preset" -i preferences-desktop-theme "COSMIC Preset" "$1" 2>/dev/null || true
}

check_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid preset name: '${1:-}'"
}

# copy_managed <source root> <target root>
copy_managed() {
  local src="$1" dst="$2" path
  for path in "${MANAGED_DIRS[@]}"; do
    [ -d "$src/$path" ] || continue
    mkdir -p "$dst/$path"
    rsync -a --delete "$src/$path/" "$dst/$path/"
  done
  for path in "${MANAGED_FILES[@]}"; do
    if [ -f "$src/$path" ]; then
      mkdir -p "$(dirname "$dst/$path")"
      rsync -a "$src/$path" "$dst/$path"
    else
      rm -f "$dst/$path"
    fi
  done
}

# same_managed <root a> <root b> — true when all managed paths are identical
same_managed() {
  local a="$1" b="$2" path
  for path in "${MANAGED_DIRS[@]}"; do
    [ -d "$a/$path" ] || [ -d "$b/$path" ] || continue
    diff -rq "$a/$path" "$b/$path" >/dev/null 2>&1 || return 1
  done
  for path in "${MANAGED_FILES[@]}"; do
    [ -e "$a/$path" ] || [ -e "$b/$path" ] || continue
    cmp -s "$a/$path" "$b/$path" || return 1
  done
}

# Warn about applets a preset references that are not installed.
check_applets() {
  local preset="$1" id found dir
  local data_dirs="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  grep -rhoE '"[A-Za-z0-9_.-]+"' "$preset"/com.system76.CosmicPanel.*/v1/plugins_* 2>/dev/null |
    tr -d '"' | sort -u | while read -r id; do
      found=0
      while IFS= read -r -d: dir; do
        [ -f "$dir/applications/$id.desktop" ] && { found=1; break; }
      done <<<"$data_dirs:"
      [ "$found" = 1 ] || echo "warning: applet not installed: $id" >&2
    done
}

current() { [ -f "$CURRENT" ] && cat "$CURRENT" || true; }

# A preset containing this marker file replaces the COSMIC dock with the
# standalone magnifying dock, which runs as its own process.
DOCK_MARKER="use-ext-dock"
DOCK_BIN="$HOME/.local/bin/cosmic-ext-dock"

# A preset containing this marker file runs Sonoma-style desktop widgets.
WIDGETS_MARKER="use-desktop-widgets"
WIDGETS_BIN="$HOME/.local/bin/mac-desktop-widgets"

# Start or stop the standalone dock to match the active preset.
sync_dock() {
  local cur
  cur="$(current)"
  if [ -n "$cur" ] && [ -e "$STORE/$cur/$DOCK_MARKER" ] && [ -x "$DOCK_BIN" ]; then
    pgrep -x cosmic-ext-dock >/dev/null || setsid -f "$DOCK_BIN" >/dev/null 2>&1
  else
    pkill -x cosmic-ext-dock || true
  fi
}

# Start or stop desktop widgets to match the active preset.
sync_widgets() {
  local cur
  cur="$(current)"
  if [ -n "$cur" ] && [ -e "$STORE/$cur/$WIDGETS_MARKER" ] && [ -x "$WIDGETS_BIN" ]; then
    pgrep -f "^$WIDGETS_BIN( |$)" >/dev/null || setsid -f "$WIDGETS_BIN" >/dev/null 2>&1
  else
    pkill -f "^$WIDGETS_BIN( |$)" || true
  fi
}

cmd_list() {
  local cur dir name mark
  cur="$(current)"
  for dir in "$STORE"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    mark="  "
    if [ "$name" = "$cur" ]; then
      mark="* "
      same_managed "$dir" "$LIVE" || name="$name (modified since apply)"
    fi
    echo "$mark$name"
  done
}

cmd_save() {
  check_name "${1:-}"
  local name="$1" force="${2:-}"
  if [ -e "$STORE/$name" ]; then
    [ "$name" != "$BASELINE" ] || die "'$BASELINE' is the locked baseline; it cannot be overwritten"
    [ "$force" = "--force" ] || die "preset '$name' exists (use: save $name --force)"
    rm -rf "${STORE:?}/$name"
  fi
  mkdir -p "$STORE/$name"
  copy_managed "$LIVE" "$STORE/$name"
  if pgrep -x cosmic-ext-dock >/dev/null; then touch "$STORE/$name/$DOCK_MARKER"; fi
  if pgrep -f "^$WIDGETS_BIN( |$)" >/dev/null; then touch "$STORE/$name/$WIDGETS_MARKER"; fi
  echo "$name" >"$CURRENT"
  echo "saved current desktop as '$name'"
}

cmd_apply() {
  check_name "${1:-}"
  local name="$1"
  [ -d "$STORE/$name" ] || die "no such preset: $name"
  [ -d "$LIVE" ] || die "COSMIC config not found: $LIVE"
  check_applets "$STORE/$name"
  # Keep the pre-apply state so unsaved tweaks are recoverable with `undo`.
  rm -rf "$PREVIOUS.new"
  mkdir -p "$PREVIOUS.new"
  copy_managed "$LIVE" "$PREVIOUS.new"
  current >"$PREVIOUS.new/.name"
  rm -rf "$PREVIOUS"
  mv "$PREVIOUS.new" "$PREVIOUS"

  copy_managed "$STORE/$name" "$LIVE"
  echo "$name" >"$CURRENT"
  sync_dock
  sync_widgets
  echo "applied '$name'"
  notify "Applied: $name"
}

cmd_undo() {
  [ -d "$PREVIOUS" ] || die "nothing to undo"
  local name
  name="$(cat "$PREVIOUS/.name" 2>/dev/null || true)"
  copy_managed "$PREVIOUS" "$LIVE"
  if [ -n "$name" ]; then echo "$name" >"$CURRENT"; else rm -f "$CURRENT"; fi
  sync_dock
  sync_widgets
  echo "restored state from before the last apply"
  notify "Undid last preset change"
}

cmd_toggle() {
  if [ "$(current)" = "$ALTERNATE" ]; then cmd_apply "$LIGHT"; else cmd_apply "$ALTERNATE"; fi
}

cmd_delete() {
  check_name "${1:-}"
  [ "$1" != "$BASELINE" ] || die "'$BASELINE' is the locked baseline; it cannot be deleted"
  [ -d "$STORE/$1" ] || die "no such preset: $1"
  rm -rf "${STORE:?}/$1"
  echo "deleted '$1'"
}

cmd_restore_full() {
  [ "${1:-}" = "--yes" ] || die "this replaces ALL of $LIVE with the full backup; re-run as: restore-full --yes"
  [ -d "$FULL_BACKUP" ] || die "no full backup at $FULL_BACKUP"
  rsync -a --delete "$FULL_BACKUP/" "$LIVE/"
  echo "$BASELINE" >"$CURRENT"
  sync_dock
  sync_widgets
  echo "restored full backup"
  notify "Restored full COSMIC backup"
}

# At login the panel can start before the notification daemon is ready and
# then skips the clock applet (it counts as a notifications applet). Check
# once after login and restart the panel if the clock is missing.
cmd_login_check() {
  sleep 15
  if grep -q ClockCenter "$LIVE/com.system76.CosmicPanel.Panel/v1/plugins_center" 2>/dev/null &&
    ! pgrep -f cosmic-ext-applet-clock-center >/dev/null; then
    pkill -x cosmic-panel || true
  fi
}

cmd_reload() {
  # cosmic-session restarts the panel automatically.
  pkill -x cosmic-panel || true
  echo "cosmic-panel restarted"
}

usage() {
  cat <<EOF
usage: cosmic-preset <command>
  list                  list presets (* = active)
  apply <name>          apply a preset
  save <name> [--force] save the current desktop as a preset
  revert                apply '$BASELINE'
  toggle                switch between '$ALTERNATE' and '$LIGHT'
  undo                  restore the state from before the last apply
  delete <name>         delete a preset
  reload                restart cosmic-panel if a change did not show up
  dock-sync             start or stop the standalone dock for the active preset
  widgets-sync          start or stop desktop widgets for the active preset
  login-check           restart the panel if the clock applet is missing after login
  restore-full --yes    restore the complete ~/.config/cosmic backup
EOF
}

mkdir -p "$STORE"
case "${1:-}" in
  list) cmd_list ;;
  apply) cmd_apply "${2:-}" ;;
  save) cmd_save "${2:-}" "${3:-}" ;;
  revert) cmd_apply "$BASELINE" ;;
  toggle) cmd_toggle ;;
  undo) cmd_undo ;;
  delete) cmd_delete "${2:-}" ;;
  reload) cmd_reload ;;
  dock-sync) sync_dock ;;
  widgets-sync) sync_widgets ;;
  login-check) cmd_login_check ;;
  restore-full) cmd_restore_full "${2:-}" ;;
  *) usage; [ -n "${1:-}" ] && [ "$1" != "-h" ] && [ "$1" != "--help" ] && exit 1 || exit 0 ;;
esac
