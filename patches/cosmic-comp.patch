diff --git a/src/backend/render/shaders/genie.frag b/src/backend/render/shaders/genie.frag
new file mode 100644
index 0000000..7cf2009
--- /dev/null
+++ b/src/backend/render/shaders/genie.frag
@@ -0,0 +1,96 @@
+// Genie (magic lamp) warp for minimize and restore animations.
+//
+// The texture holds a snapshot of the window. It is drawn over a destination
+// rectangle covering both the window and its target (the dock icon). For each
+// output pixel the shader finds the source pixel by inverting the warp, which
+// works row by row: at screen row y the window occupies a horizontal span that
+// narrows toward the target, and the rows are squashed vertically between a
+// moving top edge and a moving bottom edge.
+
+#version 100
+
+//_DEFINES_
+
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+
+uniform float alpha;
+varying vec2 v_coords;
+
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+
+// Destination size in physical pixels.
+uniform vec2 dst_size;
+// Window and target rectangles (x, y, w, h) relative to the destination.
+uniform vec4 window_rect;
+uniform vec4 target_rect;
+// 0.0 = window fully shown, 1.0 = fully collapsed into the target.
+uniform float progress;
+
+void main() {
+    vec2 pos = v_coords * dst_size;
+
+    float win_top = window_rect.y;
+    float win_bottom = window_rect.y + window_rect.w;
+    float tgt_top = target_rect.y;
+    float tgt_bottom = target_rect.y + target_rect.w;
+
+    // The bottom edge reaches the target first, the top edge follows, so the
+    // window pours into the icon instead of shrinking uniformly.
+    float bottom = mix(win_bottom, tgt_bottom, smoothstep(0.0, 0.7, progress));
+    float top = mix(win_top, tgt_top, smoothstep(0.3, 1.0, progress));
+    float height = bottom - top;
+    if (height <= 0.5) {
+        discard;
+    }
+    float v = (pos.y - top) / height;
+    if (v < 0.0 || v > 1.0) {
+        discard;
+    }
+
+    // How far this row has narrowed toward the target span: nothing at the
+    // start, everything at the end, and a smooth funnel in between that is
+    // tighter closer to the target.
+    float span = max(tgt_bottom - win_top, 1.0);
+    float row = clamp((pos.y - win_top) / span, 0.0, 1.0);
+    float pinch = smoothstep(0.0, 1.0, clamp(row + 2.0 * progress - 1.0, 0.0, 1.0));
+
+    float left = mix(window_rect.x, target_rect.x, pinch);
+    float right = mix(window_rect.x + window_rect.z, target_rect.x + target_rect.z, pinch);
+    float width = right - left;
+    if (width <= 0.5) {
+        discard;
+    }
+    float u = (pos.x - left) / width;
+    if (u < 0.0 || u > 1.0) {
+        discard;
+    }
+
+    vec4 color = texture2D(tex, vec2(u, v));
+
+    // Fade out as the window disappears into the icon.
+    float fade = 1.0 - smoothstep(0.8, 1.0, progress);
+
+#if defined(NO_ALPHA)
+    color = vec4(color.rgb, 1.0) * alpha * fade;
+#else
+    color = color * alpha * fade;
+#endif
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
diff --git a/src/backend/render/wayland/genie.rs b/src/backend/render/wayland/genie.rs
new file mode 100644
index 0000000..cfc925e
--- /dev/null
+++ b/src/backend/render/wayland/genie.rs
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Genie ("magic lamp") minimize and restore animation.
+//!
+//! The window is rendered into an offscreen texture, which is then drawn with
+//! a warp shader over a rectangle covering both the window and its minimize
+//! target, usually the app's icon in the dock.
+
+use std::borrow::{Borrow, BorrowMut};
+
+use smithay::{
+    backend::{
+        allocator::Fourcc,
+        renderer::{
+            Color32F, Frame, Offscreen,
+            element::{Element, Id, Kind, RenderElement, UnderlyingStorage},
+            gles::{GlesFrame, GlesRenderer, GlesTexProgram, GlesTexture, Uniform},
+            utils::{CommitCounter, DamageSet, OpaqueRegions, draw_render_elements},
+        },
+    },
+    utils::{Buffer, Physical, Rectangle, Scale, Size, Transform, user_data::UserDataMap},
+};
+
+use crate::backend::render::element::AsGlowRenderer;
+
+pub static GENIE_SHADER: &str = include_str!("../shaders/genie.frag");
+pub struct GenieShader(pub GlesTexProgram);
+
+impl GenieShader {
+    pub fn get<R: AsGlowRenderer>(renderer: &R) -> GlesTexProgram {
+        Borrow::<GlesRenderer>::borrow(renderer.glow_renderer())
+            .egl_context()
+            .user_data()
+            .get::<GenieShader>()
+            .expect("Custom Shaders not initialized")
+            .0
+            .clone()
+    }
+}
+
+#[derive(Debug)]
+pub struct GenieRenderElement {
+    id: Id,
+    commit: CommitCounter,
+    texture: GlesTexture,
+    texture_size: Size<i32, Buffer>,
+    /// Area covered by the window, its target and everything in between.
+    geometry: Rectangle<i32, Physical>,
+    program: GlesTexProgram,
+    uniforms: Vec<Uniform<'static>>,
+}
+
+impl GenieRenderElement {
+    /// Snapshot `elements` (the window, rendered with its geometry's top-left
+    /// corner at the origin) and build an element drawing it warped
+    /// `progress` of the way from `window` toward `target`, both given in
+    /// physical output coordinates.
+    ///
+    /// Returns `None` if the snapshot cannot be made; the caller then falls
+    /// back to the plain animation.
+    pub fn new<R, E>(
+        renderer: &mut R,
+        elements: &[E],
+        window: Rectangle<i32, Physical>,
+        target: Rectangle<i32, Physical>,
+        scale: Scale<f64>,
+        progress: f32,
+    ) -> Option<Self>
+    where
+        R: AsGlowRenderer,
+        R::TextureId: 'static,
+        E: RenderElement<R>,
+    {
+        if window.size.w <= 0 || window.size.h <= 0 {
+            return None;
+        }
+        let program = GenieShader::get(renderer);
+
+        let texture_size = Size::<i32, Buffer>::from((window.size.w, window.size.h));
+        let mut texture: GlesTexture =
+            Offscreen::<GlesTexture>::create_buffer(renderer, Fourcc::Abgr8888, texture_size)
+                .map_err(|err| tracing::warn!(?err, "genie: failed to create texture"))
+                .ok()?;
+
+        {
+            let mut target_fb = renderer
+                .bind(&mut texture)
+                .map_err(|err| tracing::warn!(?err, "genie: failed to bind texture"))
+                .ok()?;
+            let size = Size::<i32, Physical>::from((window.size.w, window.size.h));
+            let mut frame = renderer
+                .render(&mut target_fb, size, Transform::Normal)
+                .map_err(|err| tracing::warn!(?err, "genie: failed to start frame"))
+                .ok()?;
+            let full = [Rectangle::from_size(size)];
+            frame
+                .clear(Color32F::TRANSPARENT, &full)
+                .map_err(|err| tracing::warn!(?err, "genie: failed to clear"))
+                .ok()?;
+            // Framebuffer effects (background blur) sample what is already
+            // drawn and need a capture cache this offscreen pass doesn't
+            // have, so the snapshot leaves them out.
+            let plain: Vec<&E> = elements
+                .iter()
+                .filter(|elem| !elem.is_framebuffer_effect())
+                .collect();
+            draw_render_elements::<R, _, _>(&mut frame, scale, &plain, &full)
+                .map_err(|err| tracing::warn!(?err, "genie: failed to draw window"))
+                .ok()?;
+            let sync = frame
+                .finish()
+                .map_err(|err| tracing::warn!(?err, "genie: failed to finish frame"))
+                .ok()?;
+            let _ = sync.wait();
+        }
+
+        let geometry = window.merge(target);
+        let local = |rect: Rectangle<i32, Physical>| {
+            [
+                (rect.loc.x - geometry.loc.x) as f32,
+                (rect.loc.y - geometry.loc.y) as f32,
+                rect.size.w as f32,
+                rect.size.h as f32,
+            ]
+        };
+        let uniforms = vec![
+            Uniform::new(
+                "dst_size",
+                (geometry.size.w as f32, geometry.size.h as f32),
+            ),
+            Uniform::new("window_rect", local(window)),
+            Uniform::new("target_rect", local(target)),
+            Uniform::new("progress", progress.clamp(0.0, 1.0)),
+        ];
+
+        Some(Self {
+            // A new id every frame: the damage tracker then redraws the whole
+            // area, which the animation changes anyway.
+            id: Id::new(),
+            commit: CommitCounter::default(),
+            texture,
+            texture_size,
+            geometry,
+            program,
+            uniforms,
+        })
+    }
+}
+
+impl Element for GenieRenderElement {
+    fn id(&self) -> &Id {
+        &self.id
+    }
+
+    fn current_commit(&self) -> CommitCounter {
+        self.commit
+    }
+
+    fn geometry(&self, _scale: Scale<f64>) -> Rectangle<i32, Physical> {
+        self.geometry
+    }
+
+    fn src(&self) -> Rectangle<f64, Buffer> {
+        Rectangle::from_size(self.texture_size).to_f64()
+    }
+
+    fn transform(&self) -> Transform {
+        Transform::Normal
+    }
+
+    fn damage_since(
+        &self,
+        _scale: Scale<f64>,
+        _commit: Option<CommitCounter>,
+    ) -> DamageSet<i32, Physical> {
+        DamageSet::from_slice(&[Rectangle::from_size(self.geometry.size)])
+    }
+
+    fn opaque_regions(&self, _scale: Scale<f64>) -> OpaqueRegions<i32, Physical> {
+        OpaqueRegions::default()
+    }
+
+    fn alpha(&self) -> f32 {
+        1.0
+    }
+
+    fn kind(&self) -> Kind {
+        Kind::Unspecified
+    }
+}
+
+impl<R> RenderElement<R> for GenieRenderElement
+where
+    R: AsGlowRenderer,
+    R::TextureId: 'static,
+{
+    fn draw(
+        &self,
+        frame: &mut R::Frame<'_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        _opaque_regions: &[Rectangle<i32, Physical>],
+        _cache: Option<&UserDataMap>,
+    ) -> Result<(), R::Error> {
+        let gles_frame: &mut GlesFrame =
+            BorrowMut::<GlesFrame>::borrow_mut(R::glow_frame_mut(frame));
+        gles_frame
+            .render_texture_from_to(
+                &self.texture,
+                src,
+                dst,
+                damage,
+                &[],
+                Transform::Normal,
+                1.0,
+                Some(&self.program),
+                &self.uniforms,
+            )
+            .map_err(R::from_gles_error)
+    }
+
+    fn underlying_storage(&self, _renderer: &mut R) -> Option<UnderlyingStorage<'_>> {
+        None
+    }
+}
