-pub const MINIMIZE_ANIMATION_DURATION: Duration = Duration::from_millis(320);
+/// Long enough for the genie warp to read clearly, like macOS's.
+pub const MINIMIZE_ANIMATION_DURATION: Duration = Duration::from_millis(560);
 const SHAKE_ANIMATION_DURATION: Duration = Duration::from_millis(320);
 const SHAKE_AMPLITUDE: f32 = 10.0;
 
@@ -123,6 +127,32 @@ impl Animation {
         }
     }
 
+    /// For minimize and restore: the window's full-size position, the
+    /// minimize target (the dock icon) and how far the window has collapsed
+    /// into the target, from 0.0 (shown) to 1.0 (gone).
+    fn genie(&self) -> Option<(Rectangle<i32, Local>, Rectangle<i32, Local>, f32)> {
+        let elapsed = |start: &Instant| {
+            Instant::now()
+                .duration_since(*start)
+                .min(MINIMIZE_ANIMATION_DURATION)
+                .as_secs_f32()
+                / MINIMIZE_ANIMATION_DURATION.as_secs_f32()
+        };
+        match self {
+            Animation::Minimize {
+                start,
+                previous_geometry,
+                target_geometry,
+            } => Some((*previous_geometry, *target_geometry, elapsed(start))),
+            Animation::Unminimize {
+                start,
+                previous_geometry,
+                target_geometry,
+            } => Some((*target_geometry, *previous_geometry, 1.0 - elapsed(start))),
+            Animation::Tiled { .. } | Animation::Shake { .. } => None,
+        }
+    }
+
