+/// A snapshot of `mapped` warped between `window` and `icon` by the genie
+/// shader. `progress` is 0.0 with the window in place, 1.0 inside the icon.
+fn genie_element<R>(
+    renderer: &mut R,
+    mapped: &CosmicMapped,
+    window: Rectangle<i32, Local>,
+    icon: Rectangle<i32, Local>,
+    progress: f32,
+    output_scale: f64,
+    scanout_node: Option<DrmNode>,
+) -> Option<GenieRenderElement>
+where
+    R: AsGlowRenderer,
+    R::TextureId: Send + Clone + 'static,
+    CosmicMappedRenderElement<R>: RenderElement<R>,
+    CosmicWindowRenderElement<R>: RenderElement<R>,
+    CosmicStackRenderElement<R>: RenderElement<R>,
+{
+    let geometry = mapped.geometry();
+    let mut above = Vec::new();
+    let mut below = Vec::new();
+    // Render the window with its geometry's top-left corner at the origin.
+    mapped.push_render_elements(
+        renderer,
+        Point::<i32, smithay::utils::Logical>::from((-geometry.loc.x, -geometry.loc.y))
+            .to_physical_precise_round(output_scale),
+        Some(window.size.as_logical()),
+        Scale::from(output_scale),
+        1.0,
+        None,
+        scanout_node,
+        &mut |elem| above.push(elem),
+        &mut |elem| below.push(elem),
+    );
+    above.extend(below);
+    let window_physical = Rectangle::new(
+        window.loc.as_logical().to_physical_precise_round(output_scale),
+        window.size.as_logical().to_physical_precise_round(output_scale),
+    );
+    let icon_physical = icon.as_logical().to_physical_precise_round(output_scale);
+    GenieRenderElement::new(
+        renderer,
+        &above,
+        window_physical,
+        icon_physical,
+        Scale::from(output_scale),
+        progress,
+    )
+}
