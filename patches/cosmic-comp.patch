+/// Where the standalone dock (cosmic-ext-dock) shows the icon for `app_id`.
+///
+/// The dock runs on its own Wayland connection, so it cannot attach
+/// rectangles to toplevels. Instead it writes one line per app to
+/// `$XDG_RUNTIME_DIR/cosmic-ext-dock-icons`:
+/// `app_id<TAB>center_offset<TAB>size<TAB>bottom_offset`, where the offset is
+/// from the dock's horizontal center and the bottom offset from the screen's
+/// bottom edge. The dock's layer surface (namespace "dock") gives the center.
+fn ext_dock_icon_rectangle(
+    output: &Output,
+    app_id: &str,
+) -> Option<Rectangle<i32, smithay::utils::Logical>> {
+    if app_id.is_empty() {
+        return None;
+    }
+    let path = std::path::Path::new(&std::env::var_os("XDG_RUNTIME_DIR")?)
+        .join("cosmic-ext-dock-icons");
+    let contents = std::fs::read_to_string(path).ok()?;
+    let (offset, size, bottom) = contents.lines().find_map(|line| {
+        let mut fields = line.split('\t');
+        let id = fields.next()?;
+        if !id.eq_ignore_ascii_case(app_id) {
+            return None;
+        }
+        let offset: i32 = fields.next()?.parse().ok()?;
+        let size: i32 = fields.next()?.parse().ok()?;
+        let bottom: i32 = fields.next()?.parse().ok()?;
+        Some((offset, size, bottom))
+    })?;
+
+    let output_size = output.geometry().size;
+    let map = layer_map_for_output(output);
+    let center = map
+        .layers()
+        .find(|layer| layer.namespace() == "dock")
+        .and_then(|layer| map.layer_geometry(layer))
+        .map(|geo| geo.loc.x + geo.size.w / 2)
+        .unwrap_or(output_size.w / 2);
+
+    Some(Rectangle::new(
+        Point::from((center + offset - size / 2, output_size.h - bottom - size)),
+        Size::from((size, size)),
+    ))
+}
