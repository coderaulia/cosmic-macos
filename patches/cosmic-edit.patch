diff --git a/src/app_menu.rs b/src/app_menu.rs
new file mode 100644
index 0000000..2da35e1
--- /dev/null
+++ b/src/app_menu.rs
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use cosmic::widget::menu::key_bind::KeyBind;
+use mac_appmenu::{MenuItemSpec, MenuLayout, MenuSpec, format_shortcut};
+
+use crate::config::Config;
+use crate::{Action, fl};
+
+fn shortcut_for(key_binds: &HashMap<KeyBind, Action>, action: Action) -> String {
+    key_binds
+        .iter()
+        .find_map(|(kb, bound)| (*bound == action).then(|| format_shortcut(&kb.to_string())))
+        .unwrap_or_default()
+}
+
+pub fn app_menu_layout(
+    config: &Config,
+    key_binds: &HashMap<KeyBind, Action>,
+    projects: &[(String, PathBuf)],
+    has_selection: bool,
+) -> MenuLayout {
+    let sc = |action| shortcut_for(key_binds, action);
+
+    vec![
+        MenuSpec::new(
+            "file",
+            fl!("file"),
+            vec![
+                MenuItemSpec::action("file.new", fl!("new-file"))
+                    .shortcut_raw(sc(Action::NewFile)),
+                MenuItemSpec::action("file.new_window", fl!("new-window"))
+                    .shortcut_raw(sc(Action::NewWindow)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("file.open", fl!("open-file"))
+                    .shortcut_raw(sc(Action::OpenFileDialog)),
+                MenuItemSpec::action("file.close", fl!("close-file"))
+                    .shortcut_raw(sc(Action::CloseFile)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("file.open_project", fl!("menu-open-project"))
+                    .shortcut_raw(sc(Action::OpenProjectDialog)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("file.save", fl!("save"))
+                    .shortcut_raw(sc(Action::Save)),
+                MenuItemSpec::action("file.save_as", fl!("save-as"))
+                    .shortcut_raw(sc(Action::SaveAsDialog)),
+                MenuItemSpec::action("file.revert", fl!("revert-all-changes"))
+                    .shortcut_raw(sc(Action::RevertAllChanges)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action(
+                    "file.document_statistics",
+                    fl!("menu-document-statistics"),
+                )
+                .shortcut_raw(sc(Action::ToggleDocumentStatistics)),
+                MenuItemSpec::action("file.git_management", fl!("menu-git-management"))
+                    .shortcut_raw(sc(Action::ToggleGitManagement)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("file.quit", fl!("quit")).shortcut_raw(sc(Action::Quit)),
+            ],
+        ),
+        MenuSpec::new(
+            "edit",
+            fl!("edit"),
+            vec![
+                MenuItemSpec::action("edit.undo", fl!("undo")).shortcut_raw(sc(Action::Undo)),
+                MenuItemSpec::action("edit.redo", fl!("redo")).shortcut_raw(sc(Action::Redo)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("edit.cut", fl!("cut"))
+                    .shortcut_raw(sc(Action::Cut))
+                    .enabled(has_selection),
+                MenuItemSpec::action("edit.copy", fl!("copy"))
+                    .shortcut_raw(sc(Action::Copy))
+                    .enabled(has_selection),
+                MenuItemSpec::action("edit.paste", fl!("paste"))
+                    .shortcut_raw(sc(Action::Paste)),
+                MenuItemSpec::action("edit.select_all", fl!("select-all"))
+                    .shortcut_raw(sc(Action::SelectAll)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("edit.find", fl!("find")).shortcut_raw(sc(Action::Find)),
+                MenuItemSpec::action("edit.find_replace", fl!("replace"))
+                    .shortcut_raw(sc(Action::FindAndReplace)),
+                MenuItemSpec::action("edit.find_in_project", fl!("find-in-project"))
+                    .shortcut_raw(sc(Action::ToggleProjectSearch))
+                    .enabled(!projects.is_empty()),
+            ],
+        ),
+        MenuSpec::new(
+            "view",
+            fl!("view"),
+            vec![
+                MenuItemSpec::action("view.zoom_in", fl!("zoom-in"))
+                    .shortcut_raw(sc(Action::ZoomIn)),
+                MenuItemSpec::action("view.zoom_reset", fl!("default-size"))
+                    .shortcut_raw(sc(Action::ZoomReset)),
+                MenuItemSpec::action("view.zoom_out", fl!("zoom-out"))
+                    .shortcut_raw(sc(Action::ZoomOut)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::checkbox(
+                    "view.auto_indent",
+                    fl!("automatic-indentation"),
+                    config.auto_indent,
+                )
+                .shortcut_raw(sc(Action::ToggleAutoIndent)),
+                MenuItemSpec::checkbox("view.word_wrap", fl!("word-wrap"), config.word_wrap)
+                    .shortcut_raw(sc(Action::ToggleWordWrap)),
+                MenuItemSpec::checkbox(
+                    "view.line_numbers",
+                    fl!("show-line-numbers"),
+                    config.line_numbers,
+                )
+                .shortcut_raw(sc(Action::ToggleLineNumbers)),
+                MenuItemSpec::checkbox(
+                    "view.highlight_current_line",
+                    fl!("highlight-current-line"),
+                    config.highlight_current_line,
+                )
+                .shortcut_raw(sc(Action::ToggleHighlightCurrentLine)),
+                MenuItemSpec::separator(),
+                MenuItemSpec::action("view.settings", fl!("menu-settings"))
+                    .shortcut_raw(sc(Action::ToggleSettingsPage)),
+                MenuItemSpec::action("view.about", fl!("menu-about"))
+                    .shortcut_raw(sc(Action::About)),
+            ],
+        ),
+    ]
+}
+
+pub fn action_from_id(id: &str) -> Option<Action> {
+    match id {
+        "file.new" => Some(Action::NewFile),
+        "file.new_window" => Some(Action::NewWindow),
+        "file.open" => Some(Action::OpenFileDialog),
+        "file.close" => Some(Action::CloseFile),
+        "file.open_project" => Some(Action::OpenProjectDialog),
+        "file.save" => Some(Action::Save),
+        "file.save_as" => Some(Action::SaveAsDialog),
+        "file.revert" => Some(Action::RevertAllChanges),
+        "file.document_statistics" => Some(Action::ToggleDocumentStatistics),
+        "file.git_management" => Some(Action::ToggleGitManagement),
+        "file.quit" => Some(Action::Quit),
+        "edit.undo" => Some(Action::Undo),
+        "edit.redo" => Some(Action::Redo),
+        "edit.cut" => Some(Action::Cut),
+        "edit.copy" => Some(Action::Copy),
+        "edit.paste" => Some(Action::Paste),
+        "edit.select_all" => Some(Action::SelectAll),
+        "edit.find" => Some(Action::Find),
+        "edit.find_replace" => Some(Action::FindAndReplace),
+        "edit.find_in_project" => Some(Action::ToggleProjectSearch),
+        "view.zoom_in" => Some(Action::ZoomIn),
+        "view.zoom_reset" => Some(Action::ZoomReset),
+        "view.zoom_out" => Some(Action::ZoomOut),
