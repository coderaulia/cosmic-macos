+/// Notes mode: a folder of plain-text notes that save automatically.
+mod notes {
+    use std::{
+        fs,
+        path::{Path, PathBuf},
+        sync::atomic::AtomicBool,
+    };
+
+    pub static ENABLED: AtomicBool = AtomicBool::new(false);
+
+    /// `~/Documents/Notes`, created on first use.
+    pub fn dir() -> Option<PathBuf> {
+        let dir = PathBuf::from(std::env::var_os("HOME")?).join("Documents/Notes");
+        fs::create_dir_all(&dir).ok()?;
+        Some(dir)
+    }
+
+    /// The most recently modified note.
+    pub fn latest(dir: &Path) -> Option<PathBuf> {
+        fs::read_dir(dir)
+            .ok()?
+            .filter_map(Result::ok)
+            .filter(|entry| entry.path().is_file())
+            .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry.path())))
+            .max_by_key(|(modified, _)| *modified)
+            .map(|(_, path)| path)
+    }
+
+    /// One note as the sidebar shows it.
+    #[derive(Clone, Debug)]
+    pub struct Entry {
+        pub path: PathBuf,
+        /// First line of the note, or its file name when empty.
+        pub title: String,
+        /// Second line of the note.
+        pub preview: String,
+        /// Lower-cased text, for searching.
+        pub text_lower: String,
+    }
+
+    /// All notes, most recently edited first.
+    pub fn list(dir: &Path) -> Vec<Entry> {
+        let mut entries: Vec<(std::time::SystemTime, Entry)> = fs::read_dir(dir)
+            .into_iter()
+            .flatten()
+            .filter_map(Result::ok)
+            .filter(|entry| entry.path().is_file())
+            .filter_map(|entry| {
+                let modified = entry.metadata().ok()?.modified().ok()?;
+                let path = entry.path();
+                let text = fs::read_to_string(&path).unwrap_or_default();
+                let mut lines = text.lines().map(str::trim).filter(|line| !line.is_empty());
+                let short = |line: &str| -> String { line.chars().take(80).collect() };
+                let title = lines.next().map(short).unwrap_or_else(|| {
+                    path.file_stem()
+                        .map_or_else(String::new, |s| s.to_string_lossy().into_owned())
+                });
+                let preview = lines.next().map(short).unwrap_or_default();
+                Some((
+                    modified,
+                    Entry {
+                        path,
+                        title,
+                        preview,
+                        text_lower: text.to_lowercase(),
+                    },
+                ))
+            })
+            .collect();
+        entries.sort_by(|a, b| b.0.cmp(&a.0));
+        entries.into_iter().map(|(_, entry)| entry).collect()
+    }
+
+    /// A new empty note named "Note", "Note 2", "Note 3", ...
+    pub fn create(dir: &Path) -> Option<PathBuf> {
+        let path = (1..1000).map(|n| {
+            if n == 1 {
+                dir.join("Note.md")
+            } else {
+                dir.join(format!("Note {n}.md"))
+            }
+        })
+        .find(|path| !path.exists())?;
+        fs::write(&path, "").ok()?;
+        Some(path)
+    }
+}
