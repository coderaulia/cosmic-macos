+        "file.rename" => Some(Action::Rename),
+        "file.move_to_trash" => Some(Action::Delete),
+        "file.reload" => Some(Action::Reload),
+        "file.history" => Some(Action::EditHistory),
+        "file.close_tab" => Some(Action::TabClose),
+        "file.quit" => Some(Action::WindowClose),
+        "edit.cut" => Some(Action::Cut),
+        "edit.copy" => Some(Action::Copy),
+        "edit.copy_path" => Some(Action::CopyPath),
+        "edit.paste" => Some(Action::Paste),
+        "edit.select_all" => Some(Action::SelectAll),
+        "view.zoom_in" => Some(Action::ZoomIn),
+        "view.zoom_default" => Some(Action::ZoomDefault),
+        "view.zoom_out" => Some(Action::ZoomOut),
+        "view.grid" => Some(Action::TabViewGrid),
+        "view.list" => Some(Action::TabViewList),
+        "view.columns" => Some(Action::TabViewColumns),
+        "view.show_hidden" => Some(Action::ToggleShowHidden),
+        "view.folders_first" => Some(Action::ToggleFoldersFirst),
+        "view.gallery" => Some(Action::Gallery),
+        "view.settings" => Some(Action::Settings),
+        "view.about" => Some(Action::About),
+        "sort.name_asc" => Some(Action::SetSort(HeadingOptions::Name, true)),
+        "sort.name_desc" => Some(Action::SetSort(HeadingOptions::Name, false)),
+        "sort.modified_desc" => Some(Action::SetSort(HeadingOptions::Modified, false)),
+        "sort.modified_asc" => Some(Action::SetSort(HeadingOptions::Modified, true)),
+        "sort.size_asc" => Some(Action::SetSort(HeadingOptions::Size, true)),
+        "sort.size_desc" => Some(Action::SetSort(HeadingOptions::Size, false)),
+        _ => None,
+    }
+}
