+fn shortcut_for(key_binds: &HashMap<KeyBind, Action>, action: Action) -> String {
+    key_binds
+        .iter()
+        .find_map(|(kb, bound)| (*bound == action).then(|| format_shortcut(&kb.to_string())))
+        .unwrap_or_default()
+}
+
+pub fn app_menu_layout(
+    tab_opt: Option<&Tab>,
+    config: &Config,
+    key_binds: &HashMap<KeyBind, Action>,
+    clipboard_has_content: bool,
+) -> MenuLayout {
+    let sc = |action| shortcut_for(key_binds, action);
+
+    let tab_config = tab_opt.map_or(config.tab, |tab| tab.config);
+    let has_selection = tab_opt.is_some_and(|tab| {
+        tab.items_opt
+            .as_ref()
+            .is_some_and(|items| items.iter().any(|item| item.selected))
+    });
+    let is_trash = tab_opt.is_some_and(|tab| tab.location.is_trash());
