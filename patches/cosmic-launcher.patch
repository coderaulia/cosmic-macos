+/// Which kind of result this is, from the plugin that produced it.
+fn category_heading(item: &SearchResult) -> Option<&'static str> {
+    let IconSource::Name(name) = item.category_icon.as_ref()? else {
+        return None;
+    };
+    Some(match name.as_ref() {
+        "focus-windows-symbolic" => "Windows",
+        "new-window-symbolic" => "Applications",
+        "system-file-manager" => "Files",
+        "x-office-spreadsheet" => "Calculator",
+        "utilities-terminal" => "Commands",
+        "multimedia-volume-control" => "Sound",
+        "system-search" => "Web Search",
+        _ => return None,
+    })
+}
+
+impl CosmicLauncher {
+    /// Details of the highlighted result: large icon, name and description.
+    fn preview_pane(&self) -> Element<'_, Message> {
+        let Some(item) = self.launcher_items.get(self.focused) else {
+            return horizontal_space().width(Length::FillPortion(2)).into();
+        };
+        let mut pane = Column::new()
+            .spacing(8)
+            .align_x(Alignment::Center)
+            .width(Length::FillPortion(2));
+        if let Some(Some(handle)) = self.launcher_item_icon_handles.get(self.focused) {
+            pane = pane.push(
+                icon(handle.clone())
+                    .width(Length::Fixed(72.0))
+                    .height(Length::Fixed(72.0)),
+            );
+        }
+        pane = pane.push(
+            text::title4(item.name.clone())
+                .ellipsize(Ellipsize::End(EllipsizeHeightLimit::Lines(2)))
+                .align_x(Horizontal::Center),
+        );
+        if !item.description.is_empty() {
+            pane = pane.push(
+                text::caption(item.description.clone())
+                    .ellipsize(Ellipsize::End(EllipsizeHeightLimit::Lines(4)))
+                    .align_x(Horizontal::Center),
+            );
+        }
+        container(pane)
+            .width(Length::FillPortion(2))
+            .center_y(Length::Fill)
+            .padding([8, 8])
+            .into()
+    }
+}
