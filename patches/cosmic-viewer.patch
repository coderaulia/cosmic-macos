+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::collections::HashMap;
+
+use cosmic::widget::menu::key_bind::KeyBind;
+use mac_appmenu::{MenuItemSpec, MenuLayout, MenuSpec, format_shortcut};
+
+use crate::fl;
+use crate::key_binds::MenuAction;
+
+#[derive(Clone, Copy, Debug)]
+#[allow(clippy::struct_excessive_bools)]
+pub struct AppMenuState {
+    pub can_undo: bool,
+    pub can_redo: bool,
+    pub has_image: bool,
+    pub is_fullscreen: bool,
+}
+
+fn shortcut_for(key_binds: &HashMap<KeyBind, MenuAction>, action: MenuAction) -> String {
+    key_binds
+        .iter()
+        .find_map(|(kb, bound)| (*bound == action).then(|| format_shortcut(&kb.to_string())))
+        .unwrap_or_default()
+}
+
+fn file_menu(key_binds: &HashMap<KeyBind, MenuAction>, has_image: bool) -> MenuSpec {
+    let sc = |action| shortcut_for(key_binds, action);
+    MenuSpec::new(
+        "file",
+        fl!("menu-file"),
+        vec![
+            MenuItemSpec::action("file.open_file", fl!("menu-open-file"))
+                .shortcut_raw(sc(MenuAction::OpenFile)),
+            MenuItemSpec::action("file.open_folder", fl!("menu-open-folder"))
+                .shortcut_raw(sc(MenuAction::OpenFolder)),
+            MenuItemSpec::action("file.open_containing", fl!("menu-open-containing"))
+                .shortcut_raw(sc(MenuAction::OpenContaining))
+                .enabled(has_image),
+            MenuItemSpec::separator(),
+            MenuItemSpec::action("file.save", fl!("menu-save"))
+                .shortcut_raw(sc(MenuAction::Save))
+                .enabled(has_image),
+            MenuItemSpec::action("file.save_as", fl!("menu-save-as"))
+                .shortcut_raw(sc(MenuAction::SaveAs))
+                .enabled(has_image),
+            MenuItemSpec::separator(),
+            MenuItemSpec::action("file.set_wallpaper", fl!("menu-set-wallpaper"))
+                .shortcut_raw(sc(MenuAction::SetWallpaper))
+                .enabled(has_image),
+            MenuItemSpec::action("file.move_to_trash", fl!("menu-move-to-trash"))
+                .shortcut_raw(sc(MenuAction::MoveToTrash))
+                .enabled(has_image),
+            MenuItemSpec::separator(),
+            MenuItemSpec::action("file.image_details", fl!("menu-image-details"))
+                .shortcut_raw(sc(MenuAction::ImageDetails))
+                .enabled(has_image),
+            MenuItemSpec::action("file.settings", fl!("settings"))
+                .shortcut_raw(sc(MenuAction::Settings)),
+            MenuItemSpec::action("file.about", fl!("menu-about"))
+                .shortcut_raw(sc(MenuAction::About)),
+            MenuItemSpec::separator(),
+            MenuItemSpec::action("file.quit", fl!("menu-quit")).shortcut_raw(sc(MenuAction::Quit)),
+        ],
+    )
+}
+
+fn edit_menu(key_binds: &HashMap<KeyBind, MenuAction>, state: AppMenuState) -> MenuSpec {
+    let sc = |action| shortcut_for(key_binds, action);
+    let can_revert = state.can_undo || state.can_redo;
+    MenuSpec::new(
+        "edit",
+        fl!("menu-edit"),
+        vec![
+            MenuItemSpec::action("edit.undo", fl!("menu-undo"))
+                .shortcut_raw(sc(MenuAction::Undo))
+                .enabled(state.can_undo),
+            MenuItemSpec::action("edit.redo", fl!("menu-redo"))
+                .shortcut_raw(sc(MenuAction::Redo))
+                .enabled(state.can_redo),
+            MenuItemSpec::action("edit.revert_all", fl!("menu-revert-all"))
+                .shortcut_raw(sc(MenuAction::RevertAll))
+                .enabled(can_revert),
+            MenuItemSpec::separator(),
+            MenuItemSpec::action("edit.cut", fl!("menu-cut")).shortcut_raw(sc(MenuAction::Cut)),
+            MenuItemSpec::action("edit.copy", fl!("menu-copy")).shortcut_raw(sc(MenuAction::Copy)),
+            MenuItemSpec::action("edit.paste", fl!("menu-paste"))
+                .shortcut_raw(sc(MenuAction::Paste)),
+            MenuItemSpec::action("edit.copy_to_clipboard", fl!("menu-copy-to-clipboard"))
+                .shortcut_raw(sc(MenuAction::CopyToClipboard))
+                .enabled(state.has_image),
+            MenuItemSpec::separator(),
+            MenuItemSpec::action("edit.rotate_left", fl!("menu-rotate-left"))
+                .shortcut_raw(sc(MenuAction::RotateLeft))
+                .enabled(state.has_image),
+            MenuItemSpec::action("edit.rotate_right", fl!("menu-rotate-right"))
+                .shortcut_raw(sc(MenuAction::RotateRight))
+                .enabled(state.has_image),
+        ],
+    )
+}
+
+fn view_menu(key_binds: &HashMap<KeyBind, MenuAction>, state: AppMenuState) -> MenuSpec {
+    let sc = |action| shortcut_for(key_binds, action);
+    MenuSpec::new(
+        "view",
+        fl!("menu-view"),
+        vec![
+            MenuItemSpec::action("view.zoom_in", fl!("menu-zoom-in"))
+                .shortcut_raw(sc(MenuAction::ZoomIn))
+                .enabled(state.has_image),
+            MenuItemSpec::action("view.zoom_out", fl!("menu-zoom-out"))
+                .shortcut_raw(sc(MenuAction::ZoomOut))
+                .enabled(state.has_image),
+            MenuItemSpec::action("view.actual_size", fl!("menu-actual-size"))
+                .shortcut_raw(sc(MenuAction::ActualSize))
+                .enabled(state.has_image),
+            MenuItemSpec::action("view.fit_to_view", fl!("menu-fit-to-view"))
+                .shortcut_raw(sc(MenuAction::FitToView))
+                .enabled(state.has_image),
+            MenuItemSpec::separator(),
+            MenuItemSpec::checkbox(
+                "view.fullscreen",
+                fl!("menu-fullscreen"),
+                state.is_fullscreen,
+            )
+            .shortcut_raw(sc(MenuAction::Fullscreen)),
+        ],
+    )
+}
+
+#[must_use]
+#[allow(clippy::implicit_hasher)]
+pub fn app_menu_layout(
+    key_binds: &HashMap<KeyBind, MenuAction>,
+    state: AppMenuState,
+) -> MenuLayout {
+    vec![
+        file_menu(key_binds, state.has_image),
+        edit_menu(key_binds, state),
+        view_menu(key_binds, state),
+    ]
+}
+
+#[must_use]
+pub fn action_from_id(id: &str) -> Option<MenuAction> {
+    match id {
+        "file.open_file" => Some(MenuAction::OpenFile),
+        "file.open_folder" => Some(MenuAction::OpenFolder),
+        "file.open_containing" => Some(MenuAction::OpenContaining),
+        "file.save" => Some(MenuAction::Save),
+        "file.save_as" => Some(MenuAction::SaveAs),
+        "file.set_wallpaper" => Some(MenuAction::SetWallpaper),
+        "file.move_to_trash" => Some(MenuAction::MoveToTrash),
+        "file.image_details" => Some(MenuAction::ImageDetails),
+        "file.settings" => Some(MenuAction::Settings),
+        "file.about" => Some(MenuAction::About),
+        "file.quit" => Some(MenuAction::Quit),
+        "edit.undo" => Some(MenuAction::Undo),
+        "edit.redo" => Some(MenuAction::Redo),
+        "edit.revert_all" => Some(MenuAction::RevertAll),
+        "edit.cut" => Some(MenuAction::Cut),
+        "edit.copy" => Some(MenuAction::Copy),
+        "edit.paste" => Some(MenuAction::Paste),
+        "edit.copy_to_clipboard" => Some(MenuAction::CopyToClipboard),
+        "edit.rotate_left" => Some(MenuAction::RotateLeft),
+        "edit.rotate_right" => Some(MenuAction::RotateRight),
+        "view.zoom_in" => Some(MenuAction::ZoomIn),
+        "view.zoom_out" => Some(MenuAction::ZoomOut),
+        "view.actual_size" => Some(MenuAction::ActualSize),
+        "view.fit_to_view" => Some(MenuAction::FitToView),
+        "view.fullscreen" => Some(MenuAction::Fullscreen),
+        _ => None,
+    }
+}
