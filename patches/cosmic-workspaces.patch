+//! Mission Control style layout: all windows in one non-overlapping grid that
+//! fills the available area. Cell shape is chosen so the windows, scaled to
+//! fit their cells with aspect preserved, cover as much area as possible.
+
+use cosmic::iced::{Length, Point, Rectangle, Size};
+
+use super::{LayoutToplevel, ToplevelLayout};
+
+pub(crate) struct GridToplevelLayout {
+    pub spacing: f32,
+}
+
+impl GridToplevelLayout {
+    pub fn new(spacing: u32) -> Self {
+        Self {
+            spacing: spacing as f32,
+        }
+    }
+}
+
+impl ToplevelLayout for GridToplevelLayout {
+    fn size(&self) -> Size<Length> {
+        Size::new(Length::Fill, Length::Fill)
+    }
+
+    fn layout(
+        &self,
+        max_limit: Size,
+        toplevels: &[LayoutToplevel<'_>],
+    ) -> impl Iterator<Item = Rectangle> {
+        let sizes = toplevels
+            .iter()
+            .map(|t| t.preferred_size)
+            .collect::<Vec<_>>();
+        grid_cells(max_limit, &sizes, self.spacing).into_iter()
+    }
+}
+
+/// Number of columns that maximises the total on-screen area of the items.
+fn best_columns(max: Size, sizes: &[Size], spacing: f32) -> usize {
+    let n = sizes.len();
+    let mut best = (1, f32::MIN);
+    for cols in 1..=n {
+        let rows = n.div_ceil(cols);
+        let cell_w = ((max.width - spacing * (cols - 1) as f32) / cols as f32).max(1.0);
+        let cell_h = ((max.height - spacing * (rows - 1) as f32) / rows as f32).max(1.0);
+        let score: f32 = sizes
+            .iter()
+            .map(|s| {
+                let (w, h) = (s.width.max(1.0), s.height.max(1.0));
+                let scale = (cell_w / w).min(cell_h / h).min(1.0);
+                w * h * scale * scale
+            })
+            .sum();
+        if score > best.1 + 0.5 {
+            best = (cols, score);
+        }
+    }
+    best.0
+}
+
+/// Cell rectangle for each item, in order. The last row is centered.
+pub(crate) fn grid_cells(max: Size, sizes: &[Size], spacing: f32) -> Vec<Rectangle> {
+    let n = sizes.len();
+    if n == 0 {
+        return Vec::new();
+    }
+    let cols = best_columns(max, sizes, spacing);
+    let rows = n.div_ceil(cols);
+    let cell_w = ((max.width - spacing * (cols - 1) as f32) / cols as f32).max(1.0);
+    let cell_h = ((max.height - spacing * (rows - 1) as f32) / rows as f32).max(1.0);
+    let grid_h = cell_h * rows as f32 + spacing * (rows - 1) as f32;
+    let top = ((max.height - grid_h) / 2.0).max(0.0);
+    (0..n)
+        .map(|i| {
+            let (row, col) = (i / cols, i % cols);
+            let in_row = if row == rows - 1 { n - row * cols } else { cols };
+            let row_w = cell_w * in_row as f32 + spacing * (in_row - 1) as f32;
+            let left = (max.width - row_w) / 2.0;
+            Rectangle::new(
+                Point::new(
+                    left + col as f32 * (cell_w + spacing),
+                    top + row as f32 * (cell_h + spacing),
+                ),
+                Size::new(cell_w, cell_h),
+            )
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SCREEN: Size = Size::new(1600.0, 900.0);
+
+    fn overlaps(a: &Rectangle, b: &Rectangle) -> bool {
+        a.x < b.x + b.width - 0.01
+            && b.x < a.x + a.width - 0.01
+            && a.y < b.y + b.height - 0.01
+            && b.y < a.y + a.height - 0.01
+    }
+
+    #[test]
+    fn empty() {
+        assert!(grid_cells(SCREEN, &[], 16.0).is_empty());
+    }
+
+    #[test]
+    fn single_window_gets_whole_area() {
+        let cells = grid_cells(SCREEN, &[Size::new(1200.0, 700.0)], 16.0);
+        assert_eq!(cells.len(), 1);
+        assert_eq!(cells[0].size(), SCREEN);
+    }
+
+    #[test]
+    fn four_equal_windows_make_two_by_two() {
+        let sizes = vec![Size::new(1600.0, 900.0); 4];
+        let cells = grid_cells(SCREEN, &sizes, 16.0);
+        assert_eq!(cells[0].y, cells[1].y);
+        assert_eq!(cells[2].y, cells[3].y);
+        assert!(cells[2].y > cells[0].y);
+    }
+
+    #[test]
+    fn no_overlap_and_inside_bounds() {
+        for n in 1..=13 {
+            let sizes = (0..n)
+                .map(|i| Size::new(400.0 + 90.0 * i as f32, 300.0 + 30.0 * (i % 3) as f32))
+                .collect::<Vec<_>>();
+            let cells = grid_cells(SCREEN, &sizes, 16.0);
+            assert_eq!(cells.len(), n);
+            let bounds = Rectangle::new(Point::ORIGIN, SCREEN);
+            for (i, a) in cells.iter().enumerate() {
+                assert!(a.x >= -0.01 && a.y >= -0.01, "n={n} cell {i} {a:?}");
+                assert!(a.x + a.width <= bounds.width + 0.01, "n={n} cell {i}");
+                assert!(a.y + a.height <= bounds.height + 0.01, "n={n} cell {i}");
+                for b in &cells[i + 1..] {
+                    assert!(!overlaps(a, b), "n={n}: {a:?} overlaps {b:?}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn last_row_is_centered() {
+        // 5 equal windows: 3 columns, last row holds 2 and is centered.
+        let sizes = vec![Size::new(800.0, 450.0); 5];
+        let cells = grid_cells(SCREEN, &sizes, 16.0);
+        let cols = cells.iter().filter(|c| c.y == cells[0].y).count();
+        let last = &cells[cols..];
+        let left = last.first().unwrap().x;
+        let right = SCREEN.width - (last.last().unwrap().x + last.last().unwrap().width);
+        assert!((left - right).abs() < 0.01);
+    }
+}
